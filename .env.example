# O frontend agora usa autenticação por usuário/senha + JWT (tela de login).
# Nenhuma variável de ambiente é obrigatória para a autenticação.
#
# A antiga VITE_API_KEY (cabeçalho X-Api-Key) deixou de ser usada: o backend
# passou a exigir "Authorization: Bearer <token>" obtido em POST /api/auth/login.
# Este arquivo fica fora do versionamento (.env.* / *.local no .gitignore).
#
# URL da API (opcional, padrão é /api para desenvolvimento)
# Em produção, use a URL completa da API
VITE_API_URL=https://recrutamentoiaapi.foxheart.com.br